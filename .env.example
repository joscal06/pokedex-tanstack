# Copia este archivo como .env.local y completa los valores
# (Supabase → Project Settings → API Keys). Solo se necesitan para el
# minijuego de batallas en vivo; la Pokédex funciona sin ellos.

# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publicable (sb_publishable_...). Va al navegador y solo permite
# escuchar los cambios de la tabla battle_signals (RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Clave secreta (sb_secret_...). SOLO servidor: crea salas y resuelve turnos.
# Nunca la publiques ni le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
